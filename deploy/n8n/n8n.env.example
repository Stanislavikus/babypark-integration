# Copy to /etc/babypark-n8n/n8n.env and replace with a newly generated value.
# Generate the production key on the target host; never use or commit this example.
N8N_ENCRYPTION_KEY=REPLACE_WITH_A_RANDOM_64_HEX_CHARACTER_KEY
# Generate independently on the target host; same value is used only by this n8n/PostgreSQL pair.
POSTGRES_PASSWORD=REPLACE_WITH_A_DIFFERENT_RANDOM_64_HEX_CHARACTER_PASSWORD
