{
  "name": "babypark-integration",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:unit": "node --test --test-concurrency=1 tests/unit/*.test.mjs",
    "test:legacy": "node --test --test-concurrency=1 tests/characterization/gateway-current.test.mjs",
    "test:refactor": "GATEWAY_TARGET=src/gateway/index.mjs node --test --test-concurrency=1 tests/characterization/gateway-current.test.mjs",
    "test": "npm run storage:validate && npm run test:unit && npm run test:legacy && npm run test:refactor",
    "gateway:retention": "node src/gateway/ops.mjs retention",
    "gateway:sessions-rebuild": "node src/gateway/ops.mjs sessions rebuild",
    "gateway:backup": "node scripts/backup-bridge.mjs",
    "identity:bootstrap": "node scripts/identity-bootstrap.mjs",
    "identity:status": "node scripts/identity-status.mjs",
    "catalog:e6a1-benchmark": "node scripts/catalog-e6a1-benchmark.mjs",
    "catalog:serve": "node src/catalog/http/index.mjs",
    "catalog:ops": "node scripts/catalog-ops.mjs",
    "catalog:bp1-vectors": "php scripts/catalog-bp1-reference.php tests/fixtures/catalog-bp1-v1-vectors.json",
    "storage:validate": "node scripts/validate-storage-policy.mjs"
  }
}
